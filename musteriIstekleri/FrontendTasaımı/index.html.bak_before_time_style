    <!-- Müşteri Reklam Alanları Vurgulama Scripti -->
    <script>
    $(document).ready(function() {
        var isAdHighlighted = false;
        $('#btnToggleAdHighlights').on('click', function(e) {
            e.preventDefault();
            isAdHighlighted = !isAdHighlighted;
            $('body').toggleClass('ad-preview-active', isAdHighlighted);
            $(this).toggleClass('active', isAdHighlighted);
            
            if (isAdHighlighted) {
                $(this).html('<i class="fas fa-check-circle text-white"></i> <span>Vurgu Aktif (7 Alan)</span>');
                // Aktif olan paneldeki ilk reklama yumuşak kaydır
                var isNews = $('body').hasClass('show-news');
                var targetId = isNews ? '#ad-news-top' : '#ad-mag-top';
                if ($(targetId).length) {
                    $('html, body').animate({ scrollTop: $(targetId).offset().top - 80 }, 400);
                }
            } else {
                $(this).html('<i class="fas fa-bullhorn text-warning"></i> <span>Reklam Alanlarını Vurgula</span> <span class="badge bg-danger text-white ms-1" style="font-size:10px; padding:2px 6px;">7 Reklam Alanı</span>');
            }
        });
    });
    </script>
