                        <h5 class="modal-title text-white mb-0" id="modalLoginLabel">Okuyucu &amp; Abone Girişi</h5>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Kapat"></button>
                </div>
                <div class="modal-body p-4">
                    <ul class="nav nav-pills mb-3 d-flex" id="loginModalTabs" role="tablist">
                        <li class="nav-item flex-fill" role="presentation">
                            <button class="nav-link active w-100 py-2 text-center" id="tab-login-btn" data-bs-toggle="pill" data-bs-target="#tab-login-pane" type="button" role="tab" style="border-radius:0; font-weight:700;">Giriş Yap</button>
                        </li>
                        <li class="nav-item flex-fill" role="presentation">
                            <button class="nav-link w-100 py-2 text-center" id="tab-register-btn" data-bs-toggle="pill" data-bs-target="#tab-register-pane" type="button" role="tab" style="border-radius:0; font-weight:700;">Kayıt Ol</button>
                        </li>
                    </ul>
                    <div class="tab-content" id="loginModalTabsContent">
                        <div class="tab-pane fade show active" id="tab-login-pane" role="tabpanel">
                            <form>
                                <div class="mb-3">
                                    <label class="form-label text-white-50 small mb-1">E-Posta Adresi veya Abone No</label>
                                    <input type="email" class="form-control bg-dark text-white border-secondary" placeholder="ornek@kurum.com" style="border-radius:0;">
                                </div>
                                <div class="mb-3">
                                    <label class="form-label text-white-50 small mb-1">Şifre</label>
                                    <input type="password" class="form-control bg-dark text-white border-secondary" placeholder="••••••••" style="border-radius:0;">
                                </div>
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="rememberMe">
                                        <label class="form-check-label text-white-50 small" for="rememberMe">Beni Hatırla</label>
                                    </div>
                                    <a href="#" class="text-danger small">Şifremi Unuttum</a>
                                </div>
                                <button type="submit" class="btn-msi-primary w-100 py-2 mb-2">Giriş Yap</button>
                                <div class="text-center mt-3">
                                    <small class="text-white-50">Kurumsal lisans için <a href="contact.html" class="text-danger">Kurumsal Masası</a> ile iletişime geçin.</small>
                                </div>
                            </form>
                        </div>
                        <div class="tab-pane fade" id="tab-register-pane" role="tabpanel">
                            <form>
                                <div class="mb-2">
                                    <label class="form-label text-white-50 small mb-1">Ad Soyad / Kurum Adı</label>
                                    <input type="text" class="form-control bg-dark text-white border-secondary" placeholder="Ad Soyad" style="border-radius:0;">
                                </div>
                                <div class="mb-2">
                                    <label class="form-label text-white-50 small mb-1">E-Posta Adresi</label>
                                    <input type="email" class="form-control bg-dark text-white border-secondary" placeholder="ornek@kurum.com" style="border-radius:0;">
                                </div>
                                <div class="mb-3">
                                    <label class="form-label text-white-50 small mb-1">Şifre Belirleyin</label>
                                    <input type="password" class="form-control bg-dark text-white border-secondary" placeholder="••••••••" style="border-radius:0;">
                                </div>
                                <button type="submit" class="btn-msi-primary w-100 py-2 mb-2">Hesap Oluştur</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="js/jquery-3.5.1.min.js"></script>
    <script src="js/bootstrap.min.js"></script>
    <script src="js/plugin.js"></script>
    <script src="js/main.js"></script>
    <script src="js/custom-swiper.js"></script>
    <script src="js/custom-nav.js"></script>
    <script src="js/custom-dual-home.js"></script>
</body>
</html>
