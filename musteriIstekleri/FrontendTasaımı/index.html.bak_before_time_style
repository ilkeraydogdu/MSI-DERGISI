        .btn-msi-primary {
            background: var(--msi-red) !important;
            color: #ffffff !important;
            font-weight: 600 !important;
            border: none !important;
            border-radius: 30px !important;
            padding: 9px 22px !important;
            box-shadow: 0 4px 14px rgba(203, 56, 42, 0.25) !important;
            transition: all 0.2s ease !important;
        }
        .btn-msi-primary:hover {
            background: #b32a1e !important;
            transform: translateY(-1px);
        }
        .btn-msi-outline {
            background: transparent !important;
            color: #334155 !important;
            border: 1px solid #e2e8f0 !important;
            border-radius: 30px !important;
            font-weight: 600 !important;
            padding: 9px 22px !important;
            transition: all 0.2s ease !important;
        }
        .btn-msi-outline:hover {
            background: #f8fafc !important;
            color: #0f172a !important;
            border-color: #cbd5e1 !important;
        }
        .msi-mag-price-card {
            border-radius: 14px !important;
            border: 1px solid #f1f5f9 !important;
            box-shadow: 0 2px 10px rgba(15, 23, 42, 0.03) !important;
        }
        .msi-mag-price-card.featured {
            border: 2px solid var(--msi-red) !important;
            box-shadow: 0 8px 28px rgba(203, 56, 42, 0.12) !important;
        }
        .msi-mag-price-badge {
            border-radius: 20px !important;
        }
