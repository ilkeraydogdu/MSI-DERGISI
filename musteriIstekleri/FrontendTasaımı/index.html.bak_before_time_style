        .recent-item, .trend-item, .about-image-box {
            background: #ffffff !important;
            border: 1px solid var(--msi-border-subtle) !important;
            box-shadow: 0 2px 8px rgba(15, 23, 42, 0.03) !important;
            transition: all 0.2s ease !important;
        }
        .recent-item:hover, .trend-item:hover, .about-image-box:hover {
            border-color: #cbd5e1 !important;
            box-shadow: 0 8px 24px rgba(15, 23, 42, 0.06) !important;
            transform: translateY(-2px);
        }
        .msi-cat-thumb {
            border-radius: 10px !important;
            overflow: hidden !important;
            border: 1px solid var(--msi-border-subtle) !important;
            box-shadow: 0 2px 8px rgba(15, 23, 42, 0.03) !important;
            transition: all 0.25s ease !important;
        }
        .msi-cat-thumb:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(15, 23, 42, 0.08) !important;
        }
        .featured-video {
            background: #ffffff !important;
            border-top: 1px solid var(--msi-border-subtle) !important;
            border-bottom: 1px solid var(--msi-border-subtle) !important;
        }
        .cta-horizon {
            background: #090e17 !important;
            border-top: 1px solid rgba(255, 255, 255, 0.08) !important;
        }
        .footermain {
            background: #060a10 !important;
            border-top: 1px solid rgba(255, 255, 255, 0.06) !important;
        }

        /* Minimalist Clean Advertisements */
        .msi-ad-box {
            background: #ffffff !important;
            border: 1px dashed #cbd5e1 !important;
            box-shadow: 0 1px 4px rgba(15, 23, 42, 0.03) !important;
        }
        .msi-ad-box:hover {
            border-color: var(--msi-red) !important;
            box-shadow: 0 6px 18px rgba(15, 23, 42, 0.06) !important;
        }

