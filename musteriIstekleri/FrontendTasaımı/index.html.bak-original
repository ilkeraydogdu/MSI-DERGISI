    <!-- =========================================================================
         MSI PLATFORM SWITCHER BAR (HEADER ALTINDA SAĞ ÜSTTE KESKİN SWITCH KONTROLÜ)
         ========================================================================= -->
    <section id="msi-platform-switcher-bar" class="msi-switch-bar">
        <div class="container">
            <div class="d-flex align-items-center justify-content-between py-1 flex-wrap gap-2">
                <!-- Left Status & Platform Indicator -->
                <div class="msi-switch-status d-flex align-items-center gap-2">
                    <span class="msi-badge msi-badge-navy"><i class="fas fa-shield-alt me-1 text-danger"></i> MSI PLATFORM</span>
                    <span id="msi-current-mode-label" class="msi-switch-mode-text">
                        <strong class="text-white">DERGİ TANITIM MERKEZİ</strong> 
                        <span class="text-white-50 ms-2 small d-none d-md-inline">• Sayı 280 (Eylül 2026) Özel Lansmanı</span>
                    </span>
                </div>

                <!-- Right: Tactical Sharp Toggle Switch -->
                <div class="msi-switch-control-wrap d-flex align-items-center gap-2 ms-auto">
                    <button type="button" class="switch-side-label switch-label-mag active" id="label-mag">
                        <i class="fas fa-book-open me-1"></i> DERGİ TANITIM
                    </button>
                    
                    <!-- The physical tactical sliding toggle switch -->
                    <div class="msi-tactical-switch" id="msi-tactical-switch" role="switch" aria-checked="false" tabindex="0" title="Dergi Tanıtım ve Haber Portalı Arasında Geçiş Yap">
                        <div class="msi-switch-track">
                            <div class="msi-switch-thumb">
                                <span class="thumb-led"></span>
                            </div>
                        </div>
                    </div>

                    <button type="button" class="switch-side-label switch-label-news" id="label-news">
                        <i class="fas fa-newspaper me-1"></i> HABER PORTALI
                    </button>
                </div>
            </div>
        </div>
    </section>

    <!-- =========================================================================
         MSI DUAL-HOMEPAGE HORIZONTAL SLIDER VIEWPORT
         Panel 1: Dergi Tanıtım Sitesi (Solda / Varsayılan Açılış)
         Panel 2: Savunma Haber Portalı (Sağda / Switch Sağa Kayınca Gelen)
         ========================================================================= -->
    <main id="msi-dual-home-viewport">
        <div id="msi-dual-home-track">
            
            <!-- =========================================================================
                 PANEL 1: DERGİ TANITIM SİTESİ (AÇILIŞTA VARSAYILAN AKTİF ANASAYFA)
                 ========================================================================= -->
            <div id="msi-panel-magazine" class="msi-home-panel msi-home-panel-magazine">
                
                <!-- 1. HERO: 280. SAYI VE DERGİ GİRİZGÂHI (SOL: KAPAK + 3 İÇERİK KARTI | SAĞ: ÖNE ÇIKANLAR + BANNER) -->
                <section class="msi-mag-hero">
                    <div class="container position-relative" style="z-index: 2;">
                        <div class="row align-items-stretch g-4">
                            
                            <!-- SOL SÜTUN (KAPAK + ALTINDA 3 YENİ SAYI İÇERİK KARTI) -->
                            <div class="col-12 col-lg-8 msi-mag-hero-left-col">
                                <div class="d-flex flex-column h-100 justify-content-between gap-4">
                                    
                                    <!-- Üst Kutu: Yeni Sayı Kapak & Lansman -->
                                    <div class="msi-mag-hero-left-card p-4">
                                        <div class="row align-items-center g-4">
                                            <!-- Sol: Büyük Dergi Kapağı -->
                                            <div class="col-md-5 col-sm-5 text-center">
                                                <div class="msi-mag-cover-holder position-relative">
                                                    <span class="position-absolute top-0 end-0 bg-danger text-white px-2 py-1 fw-bold small" style="z-index:3; letter-spacing:1px; border-radius:0 !important; font-size:11px; box-shadow: 0 2px 6px rgba(0,0,0,0.5);">SON SAYI #280</span>
                                                    <a href="#modal-magazine" data-bs-toggle="modal" title="280. Sayıyı Dijital Olarak Çevir &amp; İncele" class="d-inline-block">
                                                        <img src="images/msi/dergi-280.webp" alt="MSI Dergisi 280. Sayı Kapağı" class="msi-mag-cover-img img-fluid" style="max-height: 380px; width: auto; object-fit: contain; margin: 0 auto; box-shadow: 0 15px 35px rgba(0,0,0,0.7);">
                                                    </a>
                                                    <div class="msi-mag-cover-specs mt-2 text-start">
                                                        <span><i class="fas fa-barcode me-1 text-danger"></i> 1305-6743</span>
                                                        <span><i class="fas fa-file-alt me-1 text-danger"></i> 116 Sayfa</span>
                                                        <span><i class="fas fa-truck me-1 text-danger"></i> D&amp;R / Kargo</span>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Sağ: Başlık, Lansman Bilgileri ve Aksiyonlar -->
                                            <div class="col-md-7 col-sm-7">
                                                <h1 class="msi-mag-hero-title mb-2" style="font-size: 26px; line-height: 1.25;">
                                                    Milli Muharip Uçak KAAN: <span class="text-danger">5. Nesil Aviyonik</span> ve Seri Üretim Mimarisi
                                                </h1>
                                                <p class="msi-mag-hero-lead mb-3" style="font-size: 13px; line-height: 1.6; color:#94a3b8;">
                                                    Türk savunma ve havacılık sanayisinin amiral gemisi MSI Dergisi, 280. sayısında KAAN'ın yerli görev bilgisayarı, Bütünleşik Aviyonik Sistemi, CTech İDA sürü haberleşmesi ve son saha testlerini tüm teknik derinliğiyle sunuyor.
                                                </p>

                                                <!-- Mini Metrikler -->
                                                <div class="row g-2 mb-3">
                                                    <div class="col-6">
                                                        <div class="p-2 border" style="background: rgba(15,25,43,0.9); border-color: rgba(255,255,255,0.1) !important;">
                                                            <div class="text-white fw-bold" style="font-size: 16px;"><span class="text-danger">116</span> SAYFA</div>
                                                            <div class="text-muted small" style="font-size: 9px; letter-spacing:0.5px;">KUŞE &amp; DİJİTAL</div>
                                                        </div>
                                                    </div>
                                                    <div class="col-6">
                                                        <div class="p-2 border" style="background: rgba(15,25,43,0.9); border-color: rgba(255,255,255,0.1) !important;">
                                                            <div class="text-white fw-bold" style="font-size: 16px;"><span class="text-danger">14</span> ÖZEL DOSYA</div>
                                                            <div class="text-muted small" style="font-size: 9px; letter-spacing:0.5px;">TEKNİK &amp; STRATEJİK</div>
                                                        </div>
                                                    </div>
                                                    <div class="col-6">
                                                        <div class="p-2 border" style="background: rgba(15,25,43,0.9); border-color: rgba(255,255,255,0.1) !important;">
                                                            <div class="text-white fw-bold" style="font-size: 16px;"><span class="text-danger">8</span> RÖPORTAJ</div>
                                                            <div class="text-muted small" style="font-size: 9px; letter-spacing:0.5px;">SEKTÖR LİDERLERİ</div>
                                                        </div>
                                                    </div>
                                                    <div class="col-6">
                                                        <div class="p-2 border" style="background: rgba(15,25,43,0.9); border-color: rgba(255,255,255,0.1) !important;">
                                                            <div class="text-white fw-bold" style="font-size: 16px;"><span class="text-danger">4</span> FUAR RAPORU</div>
                                                            <div class="text-muted small" style="font-size: 9px; letter-spacing:0.5px;">KÜRESEL ETKİNLİK</div>
                                                        </div>
                                                    </div>
                                                </div>

                                                <!-- Aksiyon Butonları -->
                                                <div class="d-flex flex-wrap gap-2">
                                                    <a href="#modal-magazine" data-bs-toggle="modal" class="btn-msi-primary py-2 px-3 text-center" style="font-size:12.5px;">
                                                        <i class="fas fa-book-reader me-2"></i> Sayıyı Çevir &amp; İncele
                                                    </a>
                                                    <a href="#msi-mag-pricing-sec" class="btn-msi-outline py-2 px-3 text-center" style="border-color: rgba(255,255,255,0.3); color:#fff; font-size:12px;">
                                                        <i class="fas fa-shopping-cart me-1"></i> Satın Al (₺280)
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Alt Kısım: 3 Tane Yeni Sayı İçerik Kartı (Yeni Sayı İçerik 1, 2, 3) -->
                                    <div class="row g-3">
                                        <!-- İçerik 1: KAAN Aviyonik Mimarisi -->
                                        <div class="col-12 col-md-4">
                                            <a href="#modal-magazine" data-bs-toggle="modal" class="msi-mag-subcard h-100 d-flex flex-column text-decoration-none">
                                                <div class="msi-mag-subcard-thumb position-relative">
                                                    <img src="images/msi/kaan.webp" alt="KAAN Aviyonik" class="img-fluid w-100">
                                                    <span class="subcard-page-badge">SAYFA 24 - 36</span>
                                                </div>
                                                <div class="p-3 d-flex flex-column flex-grow-1 justify-content-between">
                                                    <div>
                                                        <div class="d-flex align-items-center gap-1 mb-1">
                                                            <span class="msi-badge msi-badge-navy" style="font-size:9px; padding:1px 5px;">Havacılık &amp; Uzay</span>
                                                        </div>
                                                        <h5 class="subcard-title mb-1">KAAN: 5. Nesil Aviyonik ve Radar</h5>
                                                        <p class="subcard-excerpt mb-0">Görev bilgisayarı, elektro-optik hedefleme ve stealth test takvimi.</p>
                                                    </div>
                                                    <div class="subcard-meta mt-2 pt-2 border-top border-secondary border-opacity-25 d-flex align-items-center justify-content-between">
                                                        <span class="text-white-50 small" style="font-size:10px;"><i class="far fa-user text-danger me-1"></i> Prof. Dr. Metin Yılmaz</span>
                                                        <span class="text-danger fw-bold small" style="font-size:10px;">OKU &rarr;</span>
                                                    </div>
                                                </div>
                                            </a>
                                        </div>

                                        <!-- İçerik 2: Sürü İDA Hibrit Haberleşme -->
                                        <div class="col-12 col-md-4">
                                            <a href="#modal-magazine" data-bs-toggle="modal" class="msi-mag-subcard h-100 d-flex flex-column text-decoration-none">
                                                <div class="msi-mag-subcard-thumb position-relative">
                                                    <img src="images/msi/ctech-ida.webp" alt="Sürü İDA Veri Bağı" class="img-fluid w-100">
                                                    <span class="subcard-page-badge">SAYFA 42 - 50</span>
                                                </div>
                                                <div class="p-3 d-flex flex-column flex-grow-1 justify-content-between">
                                                    <div>
                                                        <div class="d-flex align-items-center gap-1 mb-1">
                                                            <span class="msi-badge msi-badge-red" style="font-size:9px; padding:1px 5px;">Mavi Vatan</span>
                                                        </div>
                                                        <h5 class="subcard-title mb-1">Sürü İDA'lar İçin Hibrit Haberleşme</h5>
                                                        <p class="subcard-excerpt mb-0">Elektronik harp sahalarında İDA sürülerinin uydu ve LOS hibrit veri bağı.</p>
                                                    </div>
                                                    <div class="subcard-meta mt-2 pt-2 border-top border-secondary border-opacity-25 d-flex align-items-center justify-content-between">
                                                        <span class="text-white-50 small" style="font-size:10px;"><i class="far fa-user text-danger me-1"></i> CTech Ar-Ge Masası</span>
                                                        <span class="text-danger fw-bold small" style="font-size:10px;">OKU &rarr;</span>
                                                    </div>
                                                </div>
                                            </a>
                                        </div>

                                        <!-- İçerik 3: AKINCI TİHA & İHA-300 -->
                                        <div class="col-12 col-md-4">
                                            <a href="#modal-magazine" data-bs-toggle="modal" class="msi-mag-subcard h-100 d-flex flex-column text-decoration-none">
                                                <div class="msi-mag-subcard-thumb position-relative">
                                                    <img src="images/msi/akinci-iha300.webp" alt="AKINCI İHA-300" class="img-fluid w-100">
                                                    <span class="subcard-page-badge">SAYFA 56 - 62</span>
                                                </div>
                                                <div class="p-3 d-flex flex-column flex-grow-1 justify-content-between">
                                                    <div>
                                                        <div class="d-flex align-items-center gap-1 mb-1">
                                                            <span class="msi-badge msi-badge-navy" style="font-size:9px; padding:1px 5px;">Güdümlü Mühimmat</span>
                                                        </div>
                                                        <h5 class="subcard-title mb-1">AKINCI &amp; İHA-300 Balistik Test</h5>
