            --msi-border-subtle: #e2e8f0;
            --msi-border-dark: rgba(255, 255, 255, 0.08);
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif !important;
            background-color: var(--msi-bg) !important;
            color: #334155 !important;
            letter-spacing: -0.01em;
            -webkit-font-smoothing: antialiased;
        }

        h1, h2, h3, h4, h5, h6, .font-heading, .section-title h2 {
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif !important;
            letter-spacing: -0.025em !important;
            font-weight: 700 !important;
            color: #0f172a !important;
        }

        /* Subtle Modern Radiuses */
        .btn, .badge, .card, .modal-content, .dropdown-menu, .form-control,
        .recent-item, .recent-image, .trend-item, .msi-mag-dossier-card,
        .msi-mag-hero-left-card, .msi-mag-hero-right-card, .msi-mag-subcard,
        .msi-mag-price-card, .msi-mag-spread-item, .msi-ad-box, .about-image-box {
            border-radius: 10px !important;
        }
        .btn-nav-edergi, .badge-edergi, .badge-live-ticker, .btn-msi-primary,
        .btn-msi-outline, .btn-slider-read, .btn-msi-ad-cta, .msi-badge,
