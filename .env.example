# MSI Dergisi & MSI TDR Platform — Environment Configuration Template
APP_NAME="MSI Dergisi & MSI TDR - Savunma Sanayii ve Havacılık Platformu"
APP_ENV=production
HOST=127.0.0.1
PORT=8090
PRIMARY_DOMAIN=msidergisi.com
NEWS_DOMAIN=savunmahaber.com
PUBLIC_URL=https://msidergisi.com

# Static & Storage Paths
STATIC_DIR=./public
SQLITE_DB_PATH=./storage/db/msi_platform.db
EDERGI_DIR=./storage/edergi

# Encrypted Off-Site & Incremental DRP Backup (RPO < 1h)
BACKUP_ENABLED=true
BACKUP_DIR=./storage/db/backups
BACKUP_ARCHIVE_DIR=./storage/db/backups/offsite
BACKUP_RETENTION_DAYS=14
BACKUP_INCREMENTAL_INTERVAL_SECS=1800
BACKUP_ENCRYPTION_KEY=
S3_BACKUP_ENDPOINT=
S3_BACKUP_BUCKET=
S3_BACKUP_REGION=eu-central-1
S3_BACKUP_PREFIX=msi-backups
S3_BACKUP_ACCESS_KEY=
S3_BACKUP_SECRET_KEY=

# Required Cryptographic Secrets (MUST be set to unique high-entropy secrets in production)
SESSION_SECRET=
LEGACY_SEED_SECRET=
WATERMARK_SECRET=
ADMIN_DEFAULT_USER=operator@msidergisi.com
ADMIN_DEFAULT_PASS=
ADMIN_PATH_SECRET=podmin

# Advertising & PayTR Gateway
AD_MAX_QUOTA_PER_KEYWORD=3
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
PAYTR_TEST_MODE=false
PAYTR_API_URL=https://www.paytr.com/odeme/api/get-token

# Mail & Rate Limiting
SMTP_FROM="[REDACTED_SESSION_FALLBACK]"
SENDMAIL_BIN=[REDACTED_SESSION_FALLBACK]
MAIL_DELIVERY_ENABLED=false
RATE_LIMIT_MAX_RPM=600
RATE_LIMIT_WINDOW_SECS=60

# Optional Monitoring
MONITORING_ENABLED=true
MONITORING_VHOSTS_PATH=/var/www/vhosts
MONITORING_NGINX_LOG_PATH=/var/log/nginx/access.log
MONITORING_FAIL2BAN_LOG_PATH=/var/log/fail2ban.log
MONITORING_CERT_PATH=/usr/local/psa/var/certificates
MONITORING_FAST_INTERVAL=15
MONITORING_MEDIUM_INTERVAL=60
MONITORING_SLOW_INTERVAL=3600
MONITORING_RETENTION_DAYS=7
MONITORING_NODE_PORTS=8090
