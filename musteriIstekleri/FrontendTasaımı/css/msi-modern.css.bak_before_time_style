/* ==========================================================================
   MSI DERGİSİ - REKLAM ALANLARI VE MİNİMAL EDİTÖRYAL BİLEŞENLER
   ========================================================================== */

/* Notice & Client Ad Preview Bar */
.msi-client-notice-bar {
  background: #0b121e;
  color: #f1f5f9;
  font-size: 13px;
  padding: 8px 0;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

.msi-client-notice-bar .notice-badge {
  background: rgba(203, 56, 42, 0.25);
  color: #ff6b5b;
  border: 1px solid rgba(203, 56, 42, 0.4);
  font-weight: 700;
  padding: 2px 8px;
  font-size: 11px;
  letter-spacing: 0.04em;
  border-radius: var(--msi-radius-sm);
  display: inline-flex;
  align-items: center;
  gap: 5px;
}

.btn-ad-toggle-highlight {
  background: #ffffff;
  color: #334155;
  border: 1px solid #cbd5e1;
  font-size: 11.5px;
  font-weight: 600;
  padding: 5px 12px;
  border-radius: 20px;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  cursor: pointer;
  transition: all 0.2s ease;
}

.btn-ad-toggle-highlight:hover {
  background: #f8fafc;
  color: #0f172a;
  border-color: #94a3b8;
}

.btn-ad-toggle-highlight.active {
  background: #cb382a;
  color: #ffffff;
  border-color: #cb382a;
  box-shadow: 0 2px 10px rgba(203, 56, 42, 0.35);
}

/* Ad Containers */
.msi-ad-wrapper {
  margin: 24px 0;
  position: relative;
  transition: all 0.3s ease;
}

.msi-ad-box {
  background: #ffffff;
  border: 1px solid #e2e8f0;
  border-radius: var(--msi-radius-md);
  padding: 10px;
  position: relative;
  overflow: hidden;
  box-shadow: 0 2px 8px rgba(15, 25, 43, 0.04);
  transition: all 0.3s ease;
}

.msi-ad-box:hover {
  border-color: #cbd5e1;
  box-shadow: 0 6px 18px rgba(15, 25, 43, 0.08);
}

.msi-ad-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8px;
  padding-bottom: 6px;
  border-bottom: 1px dashed #e2e8f0;
  font-size: 11px;
}

.msi-ad-badge {
  background: #f1f5f9;
  color: #475569;
  font-family: 'Poppins', sans-serif;
  font-weight: 700;
  font-size: 10px;
  padding: 2px 7px;
  border-radius: 4px;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  display: inline-flex;
  align-items: center;
  gap: 4px;
}

.msi-ad-badge i {
  color: var(--msi-red);
}

.msi-ad-dimensions {
  color: #94a3b8;
  font-weight: 600;
  font-size: 11px;
}

.msi-ad-contact-trigger {
  color: var(--msi-red);
  font-weight: 600;
  font-size: 11px;
  display: inline-flex;
  align-items: center;
  gap: 4px;
  cursor: pointer;
  transition: all 0.2s ease;
}

.msi-ad-contact-trigger:hover {
  text-decoration: underline;
  color: #a8271a;
}

.msi-ad-canvas {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-radius: var(--msi-radius-sm);
  position: relative;
  overflow: hidden;
  text-decoration: none !important;
}

/* 1. Leaderboard (970x90 or 728x90) */
.msi-ad-leaderboard .msi-ad-canvas {
  min-height: 90px;
  background: linear-gradient(135deg, #0b1528 0%, #17243c 60%, #1e3357 100%);
  color: #ffffff;
  padding: 12px 24px;
}

/* 2. Medium Rectangle (300x250) */
.msi-ad-medium-rect .msi-ad-canvas {
  min-height: 250px;
  background: linear-gradient(145deg, #0d1726 0%, #17253d 100%);
  color: #ffffff;
  padding: 20px;
  flex-direction: column;
  justify-content: center;
  text-align: center;
}

/* 3. In-feed Kuşak Banner (728x90) */
.msi-ad-infeed .msi-ad-canvas {
  min-height: 90px;
  background: linear-gradient(135deg, #0a1f2f 0%, #112d45 60%, #184163 100%);
  color: #ffffff;
  padding: 12px 24px;
}

/* 4. Half Page Skyscraper (300x600) */
.msi-ad-skyscraper .msi-ad-canvas {
  min-height: 520px;
  background: linear-gradient(160deg, #10141f 0%, #1c2333 50%, #111723 100%);
  color: #ffffff;
  padding: 24px 20px;
  flex-direction: column;
  justify-content: space-between;
  text-align: center;
}

/* 5. Prestige Billboard (970x250) */
.msi-ad-billboard .msi-ad-canvas {
  min-height: 180px;
  background: linear-gradient(135deg, #0c111a 0%, #161e2e 60%, #1d273a 100%);
  color: #ffffff;
  padding: 30px 40px;
}

.msi-ad-brand-pill {
  font-family: 'Poppins', sans-serif;
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: #38bdf8;
  display: inline-flex;
  align-items: center;
  gap: 5px;
  margin-bottom: 4px;
}

.msi-ad-brand-pill.gold {
  color: #fbbf24;
}

.msi-ad-brand-pill.emerald {
  color: #34d399;
}

.msi-ad-title {
  color: #ffffff;
  font-family: 'Poppins', sans-serif;
  font-size: 16px;
  font-weight: 700;
  margin: 0 0 4px 0;
  line-height: 1.3;
}

.msi-ad-desc {
  color: #94a3b8;
  font-size: 12px;
  margin: 0;
  line-height: 1.4;
  max-width: 580px;
}

.btn-msi-ad-cta {
  background: var(--msi-red);
  color: #ffffff;
  font-family: 'Poppins', sans-serif;
  font-size: 12px;
  font-weight: 700;
  padding: 8px 16px;
  border-radius: var(--msi-radius-sm);
  white-space: nowrap;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  transition: all 0.2s ease;
  box-shadow: 0 4px 12px rgba(203, 56, 42, 0.3);
}

.btn-msi-ad-cta:hover {
  background: #ffffff;
  color: var(--msi-navy);
  box-shadow: 0 4px 16px rgba(255, 255, 255, 0.2);
}

/* CLIENT AD PREVIEW ACTIVE HIGHLIGHT */
body.ad-preview-active .msi-ad-box {
  outline: 3px dashed #0284c7 !important;
  outline-offset: 4px;
  box-shadow: 0 0 25px rgba(2, 132, 199, 0.35) !important;
  background: #f0f9ff !important;
  animation: pulseAd 2s infinite ease-in-out;
}

body.ad-preview-active .msi-ad-badge {
  background: #0284c7 !important;
  color: #ffffff !important;
  font-weight: 800 !important;
}

@keyframes pulseAd {
  0% { outline-color: #0284c7; }
  50% { outline-color: #f43f5e; }
  100% { outline-color: #0284c7; }
}

@media (max-width: 991px) {
  .msi-ad-billboard .msi-ad-canvas,
  .msi-ad-leaderboard .msi-ad-canvas {
    flex-direction: column;
    text-align: center;
    gap: 14px;
    padding: 16px;
  }
}
